PORT=7331
DISABLE_SIGNUP=false

# Plan limits (seats, documents per month, AI extractions) and trial expiry are only actually
# refused when this is "true"; set it to "false" and every plan behaves as unlimited and an
# expired trial never blocks anything. Users whose account has role="admin" are exempt either way.
ENFORCE_PLAN_LIMITS=true

# Required when using docker-compose.build.yml — set a strong, unique password.
# The same value is used in DATABASE_URL, so update both together.
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="change-me-to-a-strong-password"
POSTGRES_DB="document_inbox"

UPLOAD_PATH="./data/uploads"
DATABASE_URL="postgresql://user@localhost:5432/document_inbox"

OPENAI_MODEL_NAME="gpt-4o-mini"
OPENAI_API_KEY=""  # "sk-..."

AI_PROVIDER="gemini"  # "openai" or "gemini"
GEMINI_MODEL_NAME="gemini-2.5-flash"
GEMINI_API_KEY=""  # your Google Gemini API key

# Document parsing (MinerU, https://mineru.net). Uploaded documents are sent to MinerU's
# cloud over TLS and come back as markdown; only that text is then sent to the LLM above.
# Create a token at https://mineru.net/apiManage/token — tokens expire after 14 days.
# Without a token the app still boots, but every document job fails with mineru_not_configured.
# Account limits: 200 MB and 600 pages per file, ~2000 priority pages per day.
MINERU_API_TOKEN=""
MINERU_API_BASE="https://mineru.net"
# "vlm" is the accurate default; "pipeline" is the faster, lighter model.
MINERU_MODEL_VERSION="vlm"
MINERU_POLL_INTERVAL_MS="5000"
MINERU_TIMEOUT_MS="600000"

# Semantic document search (RAG). Optional — leave EMBEDDINGS_BASE_URL empty and the feature is
# dark: documents are still parsed and extracted, but their text is never embedded and the AI
# assistant is not given the document-search tool. Set the base URL to turn it on. To actually
# take effect the values must be set on BOTH the web app and the job worker — the worker is what
# runs the embed jobs the web enqueues.
#
# The model must produce 768-dimensional vectors — the vector column is fixed at 768, so a model of
# any other size fails the embed job with embedding_dims_mismatch. The client applies the right
# retrieval prefix per model family automatically (nomic / bge / e5), so just set the model name.
#
# EMBEDDINGS_FORMAT selects the wire protocol:
#   "openai"      — an OpenAI-compatible /embeddings endpoint. Use for Ollama and for a Hugging
#                   Face TEI Inference Endpoint (dedicated), which serves /v1/embeddings.
#                     Ollama:      EMBEDDINGS_BASE_URL="http://localhost:11434/v1", model "nomic-embed-text"
#                     HF Endpoint: EMBEDDINGS_BASE_URL="https://<id>.<region>.aws.endpoints.huggingface.cloud/v1"
#   "huggingface" — Hugging Face's FREE serverless Inference API (feature-extraction task). No
#                   dedicated endpoint to manage; a cold model 503s and is retried automatically.
#                     EMBEDDINGS_FORMAT="huggingface"
#                     EMBEDDINGS_BASE_URL="https://router.huggingface.co/hf-inference"
#                     EMBEDDINGS_MODEL_NAME="BAAI/bge-base-en-v1.5"   # 768-dim, verified served free
#                     EMBEDDINGS_API_KEY="hf_..."   # token with Inference Providers permission
#     NOTE: nomic-embed-text is NOT served by HF's free serverless tier (it has no provider
#     mapping and returns "Model not supported by provider hf-inference"). Use BAAI/bge-base-en-v1.5
#     (English) or intfloat/multilingual-e5-base (multilingual) there — both are 768-dim and free.
#     To use nomic specifically, run it on Ollama or a paid HF TEI Inference Endpoint ("openai" mode).
EMBEDDINGS_BASE_URL=""
EMBEDDINGS_API_KEY=""  # optional for Ollama; required for Hugging Face
EMBEDDINGS_FORMAT="openai"  # "openai" or "huggingface"
EMBEDDINGS_MODEL_NAME="nomic-embed-text-v1"  # Ollama: "nomic-embed-text"; free HF: "BAAI/bge-base-en-v1.5"
EMBEDDINGS_DIMENSIONS="768"
EMBEDDINGS_BATCH_SIZE="32"
EMBEDDINGS_TIMEOUT_MS="30000"

# Detach the embed job from the request that produced it (upload/dictation), so that request
# returns as soon as its own OCR/ASR + LLM work is done instead of also waiting for indexing.
# Off by default: the embed runs inline, awaited, exactly as it always has.
#
# REQUIRES a drain driver hitting /api/internal/jobs/process (POST, `Authorization: Bearer
# INTERNAL_WORKER_SECRET`) on an interval — there is nothing Vercel-specific about that route, so
# any external cron works (e.g. cron-job.org hitting it every minute with no body). Without a
# driver behind it, EMBED_DETACHED=true just means a dropped kick sits queued forever.
EMBED_DETACHED="false"

# Auth Config — Supabase Auth. NEXT_PUBLIC_ vars are also read client-side (lib/supabase/client.ts);
# SUPABASE_SERVICE_ROLE_KEY is admin-privileged and must never carry that prefix.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
# From the Supabase dashboard's Before User Created Auth Hook config (Authentication -> Hooks),
# the "v1,whsec_..." secret — see app/api/internal/auth/signup-allowed/route.ts.
SUPABASE_AUTH_HOOK_SECRET=""
# Automatic logoff (HIPAA §164.312(a)(2)(iii)), enforced in lib/supabase/middleware.ts regardless
# of Supabase plan tier — the dashboard's own Inactivity Timeout setting is Pro-plan only.
SESSION_IDLE_TIMEOUT_MINUTES="15"

# "Continue with Google" is only offered when BOTH of these are set. This is a UI-only flag now —
# the actual Google provider is registered on the Supabase project's own dashboard, not here; keep
# the two in sync by hand (see isGoogleAuthEnabled in lib/config.ts).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Stripe Configuration
STRIPE_SECRET_KEY=""  # "sk_live_..." or "sk_test_..."
STRIPE_WEBHOOK_SECRET=""  # "whsec_..."

# Resend Configuration (optional, use if you want to send emails)
RESEND_API_KEY=""  # "re_..."
RESEND_AUDIENCE_ID=""  # "aud_..."
RESEND_FROM_EMAIL="DocuBite <user@localhost>"

# DocuBite production services (AWS)
AWS_REGION="eu-west-1"
AWS_S3_DOCUMENTS_BUCKET=""
AWS_S3_KMS_KEY_ID=""
MALWARE_SCAN_URL=""
INTERNAL_WORKER_SECRET="replace-with-a-24-character-minimum-secret"

# Configure these price IDs in Stripe before enabling self-serve checkout.
STRIPE_STARTER_PRICE_ID=""
STRIPE_GROWTH_PRICE_ID=""

# Outbound integrations (webhooks, API keys, accounting connectors). Leave SECRETS_ENCRYPTION_KEY
# empty and the whole surface is dark — the sidebar entry is hidden and nothing can be minted.
# Set it to 32 random bytes, base64-encoded (AES-256-GCM key for webhook secrets & OAuth tokens):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# To ROTATE: move the current value to SECRETS_ENCRYPTION_KEY_PREVIOUS, set a fresh key here. The
# previous key is accepted for DECRYPT ONLY; stored secrets re-seal under the new key on next write.
# LOSING this key forces re-auth of every connector and rotation of every webhook secret.
SECRETS_ENCRYPTION_KEY=""
SECRETS_ENCRYPTION_KEY_PREVIOUS=""

# Accounting connectors (P2): push a reviewed invoice/receipt to QuickBooks or Xero as a bill.
# Each provider needs its own client id/secret (an app registered with that provider) AND
# SECRETS_ENCRYPTION_KEY above — without either, that provider's card stays hidden on the
# Integrations page. Leave both providers' credentials empty to keep this surface entirely dark.
QUICKBOOKS_CLIENT_ID=""
QUICKBOOKS_CLIENT_SECRET=""
QUICKBOOKS_ENVIRONMENT="sandbox"  # "sandbox" or "production"
XERO_CLIENT_ID=""
XERO_CLIENT_SECRET=""

# Bigcapital: no OAuth client — every workspace gets an auto-provisioned, isolated organization on
# this instance instead, so BIGCAPITAL_ENABLED is a deliberate second gate on top of
# SECRETS_ENCRYPTION_KEY. Leave it "false" (the default) on any deployment that only wants
# webhooks/API keys from the encryption key above — otherwise every new workspace would silently
# sign up a real Bigcapital account and provision an organization.
#
# This must be the URL a human lands on and gets a working UI from ("Open in Bigcapital" links here
# too) — not a bare backend API host with no UI at all. A self-hosted install that runs the web app
# and API as two separate dev processes (Vite on one port, the API on another) usually has the web
# app's port proxy every /api/* call through to the API port; point this at THAT port, not the API's.
BIGCAPITAL_API_BASE="http://localhost:4000"
BIGCAPITAL_ENABLED="false"

# Cap on simultaneous database connections. Leave unset for a real Postgres. Set to 1 when
# DATABASE_URL points at a local `prisma dev` database: that server is PGlite and accepts only
# one connection, so anything higher fails intermittently with P1017.
# DATABASE_POOL_MAX=1
