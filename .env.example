PORT=7331
DISABLE_SIGNUP=false

# Plan limits (seats, documents per month, AI extractions) and trial expiry are only actually
# refused when this is "true"; set it to "false" and every plan behaves as unlimited and an
# expired trial never blocks anything. Users whose account has role="admin" are exempt either way.
ENFORCE_PLAN_LIMITS=true

# Required when using docker-compose.build.yml — set a strong, unique password.
# The same value is used in DATABASE_URL, so update both together.
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="change-me-to-a-strong-password"
POSTGRES_DB="document_inbox"

UPLOAD_PATH="./data/uploads"
DATABASE_URL="postgresql://user@localhost:5432/document_inbox"

OPENAI_MODEL_NAME="gpt-4o-mini"
OPENAI_API_KEY=""  # "sk-..."

AI_PROVIDER="gemini"  # "openai" or "gemini"
GEMINI_MODEL_NAME="gemini-2.5-flash"
GEMINI_API_KEY=""  # your Google Gemini API key

# Document parsing (MinerU, https://mineru.net). Uploaded documents are sent to MinerU's
# cloud over TLS and come back as markdown; only that text is then sent to the LLM above.
# Create a token at https://mineru.net/apiManage/token — tokens expire after 14 days.
# Without a token the app still boots, but every document job fails with mineru_not_configured.
# Account limits: 200 MB and 600 pages per file, ~2000 priority pages per day.
MINERU_API_TOKEN=""
MINERU_API_BASE="https://mineru.net"
# "vlm" is the accurate default; "pipeline" is the faster, lighter model.
MINERU_MODEL_VERSION="vlm"
MINERU_POLL_INTERVAL_MS="5000"
MINERU_TIMEOUT_MS="600000"

# Auth Config
BETTER_AUTH_SECRET="random-secret-key"  # please use any long random string here

# "Continue with Google" is only offered when BOTH of these are set. Register
# {BASE_URL}/api/auth/callback/google as an authorised redirect URI in Google Cloud.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Stripe Configuration
STRIPE_SECRET_KEY=""  # "sk_live_..." or "sk_test_..."
STRIPE_WEBHOOK_SECRET=""  # "whsec_..."

# Resend Configuration (optional, use if you want to send emails)
RESEND_API_KEY=""  # "re_..."
RESEND_AUDIENCE_ID=""  # "aud_..."
RESEND_FROM_EMAIL="DocuBite <user@localhost>"

# DocuBite production services (AWS)
AWS_REGION="eu-west-1"
AWS_S3_DOCUMENTS_BUCKET=""
AWS_S3_KMS_KEY_ID=""
MALWARE_SCAN_URL=""
INTERNAL_WORKER_SECRET="replace-with-a-24-character-minimum-secret"

# Configure these price IDs in Stripe before enabling self-serve checkout.
STRIPE_STARTER_PRICE_ID=""
STRIPE_GROWTH_PRICE_ID=""

# Cap on simultaneous database connections. Leave unset for a real Postgres. Set to 1 when
# DATABASE_URL points at a local `prisma dev` database: that server is PGlite and accepts only
# one connection, so anything higher fails intermittently with P1017.
# DATABASE_POOL_MAX=1
