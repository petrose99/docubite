{
  "name": "docubite",
  "version": "0.8.5",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "node -e \"require('fs').rm('.next',{recursive:true,force:true},()=>{})\"",
    "dev": "next dev --turbopack",
    "build": "prisma migrate deploy && next build",
    "build:ci": "next build",
    "start": "prisma migrate deploy && next start",
    "lint": "eslint .",
    "worker:jobs": "tsx --env-file .env worker/job-worker.ts",
    "db:seed": "tsx --env-file .env prisma/seed.ts",
    "postinstall": "prisma generate && node scripts/fix-next-admin-paths.mjs",
    "db:generate": "prisma generate && node scripts/fix-next-admin-paths.mjs",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-sdk/google": "^2.0.88",
    "@ai-sdk/react": "^2.0.240",
    "@aws-sdk/client-s3": "^3.0.0",
    "@langchain/core": "^1.2.3",
    "@langchain/google-genai": "^2.2.0",
    "@langchain/openai": "^1.5.5",
    "@premieroctet/next-admin": "^8.4.2",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-slot": "^1.2.0",
    "@react-email/render": "^2.1.0",
    "@sentry/nextjs": "^10.67.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "@univerjs/preset-sheets-core": "0.25.1",
    "@univerjs/presets": "0.25.1",
    "ai": "^5.0.237",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "lucide-react": "^1.25.0",
    "next": "^16.2.10",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "resend": "^6.17.2",
    "sharp": "^0.35.3",
    "sonner": "^2.0.8",
    "standardwebhooks": "^1.0.0",
    "stripe": "^18.0.0",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.23.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@premieroctet/next-admin-generator-prisma": "^1.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.10",
    "postcss": "^8.5.20",
    "prisma": "^7.8.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@hono/node-server": "^1.19.14",
    "@prisma/dev": "^0.24.14",
    "postcss": "^8.5.20",
    "utf7": {
      "semver": "^7.7.2"
    },
    "sharp": "^0.35.3"
  }
